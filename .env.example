# ==============================================================================
# CampusSage: Environment Configuration Template
# ==============================================================================
# Instructions:
# - For Local Development: Copy this file to '.env' and customize as needed.
# - For Render Cloud Deployment: Enter these variables in the Render Dashboard
#   under "Environment Variables". Do NOT commit real secrets to GitHub.
# ==============================================================================

# Application Environment
# "development" (local dev) | "production" (Render / cloud)
# Render automatically sets RENDER=true, which auto-selects production mode.
ENVIRONMENT=production
DEBUG=false
APP_NAME=CampusSage

# Web Server Port (Render sets this dynamically via $PORT)
PORT=10000

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# "groq"   -> Recommended for Production on Render (Free, fast cloud inference)
# "ollama" -> Recommended for Local Development (Runs locally at http://localhost:11434)
LLM_PROVIDER=groq

# Groq Cloud API (Required for live AI answers in production on Render)
# 1. Sign up for free at: https://console.groq.com
# 2. Create an API key under "API Keys"
# 3. In Render, add: GROQ_API_KEY = gsk_...
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama Settings (Used only when LLM_PROVIDER=ollama during local dev)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# ------------------------------------------------------------------------------
# Vector Store & Embedding Settings
# ------------------------------------------------------------------------------
CHROMA_COLLECTION=campus_notices
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=120
SIMILARITY_TOP_K=4
