# CampusSage Production & Development Environment Variables
APP_NAME=CampusSage
DEBUG=False

# LLM Selection: "ollama" (local) | "groq" (cloud/free tier) | "gemini" | "openai"
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Groq API Configuration (Fast, zero-cost cloud LLM inference: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional alternative cloud providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# Vector Store & Embeddings Configuration
CHROMA_COLLECTION=campus_notices
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=120
SIMILARITY_TOP_K=4
