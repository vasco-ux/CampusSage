# CampusSage Configuration File
APP_NAME=CampusSage
DEBUG=True

# LLM Selection: "ollama" | "groq" | "gemini" | "openai"
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Optional Hosted LLM Keys (if not using local Ollama)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
OPENAI_API_KEY=

# Vector Store & Embeddings
CHROMA_COLLECTION=campus_notices
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=700
CHUNK_OVERLAP=120
SIMILARITY_TOP_K=4
